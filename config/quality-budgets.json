{
  "healthScore": {
    "comment": "Read by scripts/doctor/cli.ts. 'penalties' are points deducted per gap of each severity. 'weights' must sum to 1.0 and decide the overall score. 'categoryMap' routes every gap category from scripts/types/gaps.ts to a scored dimension; the doctor reports any category missing from this map instead of silently ignoring it.",
    "penalties": {
      "high": 20,
      "medium": 10,
      "low": 0
    },
    "weights": {
      "testing": 0.22,
      "ci": 0.18,
      "typeSafety": 0.18,
      "quality": 0.17,
      "security": 0.15,
      "agentContext": 0.1
    },
    "categoryMap": {
      "testing": "testing",
      "ci": "ci",
      "git-hooks": "ci",
      "git": "ci",
      "typescript": "typeSafety",
      "linting": "quality",
      "quality": "quality",
      "architecture": "quality",
      "performance": "quality",
      "accessibility": "quality",
      "security": "security",
      "environment": "security",
      "dependencies": "security",
      "docker": "security",
      "agent-context": "agentContext",
      "documentation": "documentation",
      "observability": "documentation"
    }
  },
  "budgets": {
    "performance": {
      "buildTimeMs": 300000,
      "testTimeMs": 60000,
      "bundleSizeKb": 100,
      "cssSizeKb": 50
    },
    "quality": {
      "testCoveragePercent": 80,
      "lintErrorsMax": 0,
      "securityVulnerabilitiesMax": 0
    },
    "accessibility": {
      "contrastRatioMin": 4.5,
      "keyboardNavigationScoreMin": 95
    },
    "seo": {
      "structuredDataScoreMin": 90,
      "metaTagsCompletenessMin": 85
    }
  },
  "overrides": {
    "development": {
      "performance": {
        "buildTimeMs": 600000
      }
    },
    "legacy-projects": {
      "quality": {
        "testCoveragePercent": 50
      }
    }
  },
  "reporting": {
    "format": "table",
    "output": "console",
    "failOnBudgetExceeded": false,
    "showRecommendations": true
  }
}
