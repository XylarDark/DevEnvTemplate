{
  "name": "devenv-template",
  "version": "3.0.0",
  "description": "Doctor for your development environment - Diagnose, prescribe, and cure issues while coding with AI assistants",
  "bin": {
    "devenv-init": "./scripts/init.js"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/tools/ensure-gitignore.js",
    "clean": "node scripts/tools/clean.js",
    "build": "tsc --build",
    "build:clean": "npm run clean && npm run build",
    "build:watch": "tsc --build --watch",
    "prebuild": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.js",
    "test:unit": "npm run build && node --test tests/unit/**/*.test.js",
    "test:integration": "npm run build && node --test tests/integration/**/*.test.js",
    "test:fast": "npm run build && node --test tests/unit/**/*.test.js",
    "test:slow": "npm run build && node --test tests/integration/**/*.test.js",
    "test:watch": "npm run build && node --test --watch tests/**/*.test.js",
    "doctor": "node dist/scripts/doctor/cli.js",
    "doctor:fix": "node dist/scripts/doctor/cli.js --fix",
    "agent:init": "node dist/scripts/agent/cli-simple.js",
    "agent:init:advanced": "node dist/scripts/agent/cli.js",
    "cleanup": "node dist/scripts/cleanup/cli.js",
    "cleanup:dry-run": "node dist/scripts/cleanup/cli.js --dry-run",
    "cleanup:apply": "node dist/scripts/cleanup/cli.js --apply",
    "organize-docs": "node dist/scripts/tools/docs-organizer.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/tools/verify.js",
    "check:doc-links": "node scripts/tools/check-doc-links.js",
    "check:encoding": "node scripts/tools/fix-mojibake.js --check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.10.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "commitlint": "^21.2.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0"
  }
}
