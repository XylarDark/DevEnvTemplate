{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "module": "commonjs",
    // ES2022 for `Error(message, { cause })`, which the error-chaining lint rule requires.
    // Safe against the Node 24 floor in package.json engines.
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["scripts/**/*.ts", ".github/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
