# Secrets: never commit real environment files. Templates (.env.example) are tracked.
.env
.env.*
!.env.example
!.env.*.example

# A real MCP config holds credentials and names commands the agent will execute. Only the
# example is tracked; see docs/guides/mcp-hygiene.md.
.cursor/mcp.json
.mcp.json
!.cursor/mcp.json.example

# DevEnv reports and generated files. The doctor writes everything here, so ignore the
# whole directory rather than naming individual report files - listing them by name is how
# ad-hoc analysis output ended up committed.
.devenv/

# The same report names, for hosts that embed this template at a different path.
stack-report.json
gaps-report.md
gaps-report.json
health-report.json
health-before.json
health-after.json
input.txt
*.log

# Keep structure but ignore generated content

# Build artifacts
# dist/ is committed so doctor runs after npm install without a manual tsc step.
# CI runs `npm run check:dist-sync` to keep it aligned with TypeScript sources.
node_modules/
tsconfig.tsbuildinfo
*.tsbuildinfo
